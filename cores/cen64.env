# cen64

CORE_PIN="master"

SUMMARY="Nintendo 64 emulator with the QTea frontend"

CORE_CC="clang"
CORE_AR="llvm-ar"
CORE_CFLAGS="-O2 -flto"

# Inert on this path, kept for accuracy. A static JG core is assembled with
# `ar -rcs` and never linked, so LDFLAGS is only consulted by the module and
# standalone targets, which this build skips. The -flto that matters at link
# time is the one QTEA_LTO puts on QTea's link line below.
CORE_LDFLAGS="-flto"

QTEA_CMAKE_ARGS="-DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DQTEA_LTO=ON"
APT_DEPS="clang llvm lld"
PACMAN_DEPS="mingw-w64-ucrt-x86_64-clang mingw-w64-ucrt-x86_64-llvm mingw-w64-ucrt-x86_64-lld"
