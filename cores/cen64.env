# cen64

CORE_PIN="master"

SUMMARY="Nintendo 64 emulator with the QTea frontend"

CORE_CC="clang"
CORE_CFLAGS="-O2 -flto"
CORE_LDFLAGS="-flto"

QTEA_CMAKE_ARGS="-DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DQTEA_LTO=ON"

# The archiver and the linker are the two things that differ per platform.
case "$PLATFORM" in
linux)
    CORE_AR="llvm-ar"
    APT_DEPS="clang llvm lld"
    ;;

macos)
    :
    ;;

windows)
    CORE_AR="llvm-ar"
    PACMAN_DEPS="mingw-w64-ucrt-x86_64-clang mingw-w64-ucrt-x86_64-llvm mingw-w64-ucrt-x86_64-lld"
    QTEA_CMAKE_ARGS="$QTEA_CMAKE_ARGS -DCMAKE_CXX_FLAGS=-fuse-ld=lld"
    ;;
esac
