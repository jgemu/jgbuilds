# Refs shared by every core build.
#
# Changing either of these rebuilds and re-publishes every core, since both
# are linked into every binary. Per-core refs live in cores/<name>.env.

JG_PIN="master"

# QTea has not had a tagged release yet. Pin this to a tag once it does, or
# releases stop being reproducible.
QTEA_PIN="master"
